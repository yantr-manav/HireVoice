# ---------------------------------------------------------------------------
# Hirevoice · environment
# Copy to .env.local for local development. No .env file is committed.
# ---------------------------------------------------------------------------

# Supabase (Project Settings > API). The demo workspace runs without these.
# New projects issue a publishable key; the anon JWT is still accepted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres (Project Settings > Database > Connection string).
# Percent-encode special characters in the password. Prefer the session pooler
# (port 5432) in serverless and Cloud Run. This project is Node/TypeScript, so
# it connects with `pg` (node-postgres); asyncpg is the Python equivalent.
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
# When unset, the runtime tables fall back to local SQLite.
DATABASE_URL=
# Optional direct (non-pooler) URL, used only if DATABASE_URL is absent.
SUPABASE_DB_URL=

# Server only. Never expose as NEXT_PUBLIC_*.
# Used for PII reveal, invite creation, scoring writes and audit events.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used when building invite links and redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google Workspace (Gmail, Calendar + Meet, Drive, Docs, Sheets)
# ---------------------------------------------------------------------------
# Create an OAuth 2.0 Client (Web application) in Google Cloud, enable the
# Gmail, Calendar, Google Meet, Drive, Docs and Sheets APIs, then add the
# redirect URI below. GOOGLE_OAUTH_* names are still accepted as aliases.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# 32-byte base64 key for AES-256-GCM connector token encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If omitted in local development, a device-local secret file is used.
CONNECTOR_ENCRYPTION_KEY=

# Optional: spreadsheet used by "append to tracker".
HIREVOICE_TRACKER_SHEET_ID=

# ---------------------------------------------------------------------------
# Gemini and Gemma (Google AI Studio)
# ---------------------------------------------------------------------------
# One key is enough. Add more to spread free-tier quota; the server rotates
# keys, cools a quota-limited key, then falls back to the next model.
# Accepted forms: GEMINI_API_KEYS (comma separated), GEMINI_API_KEY,
# GEMINI_API_KEY_2, GEMINI_API_KEY_3, GOOGLE_AI_API_KEYS, GEMMA_API_KEYS.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMMA_API_KEYS=
GOOGLE_AI_API_KEYS=

# Optional model overrides.
AI_MODEL_FAST=
AI_MODEL_DEEP=
AI_MODEL_SMALL=
AI_MODEL_GEMMA=
AI_MODEL_COMMAND=
AI_MODEL_LIVE=

# ---------------------------------------------------------------------------
# Workspace storage
# ---------------------------------------------------------------------------
# Local SQLite is used now. By default the database lives outside the project
# in <os tmp>/hirevoice-data/hirevoice.db so dev file watching stays stable.
# HIREVOICE_DATA_DIR=/tmp/hirevoice
# HIREVOICE_DB=:memory:

# Shared secret for scheduled jobs (retention sweep, digest).
CRON_SECRET=
